# ------------------------------------------------------------------
# Copie para .env.local (desenvolvimento) e configure as mesmas
# variáveis na Vercel (Settings > Environment Variables).
# Nunca faça commit do .env.local.
# ------------------------------------------------------------------

# URL pública do site, sem barra no final. Usada em e-mails, SEO e QR Codes.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase — Project Settings > API Keys
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Chave secreta: SOMENTE no servidor. Ignora RLS. Usada para excluir contas,
# processar webhooks e no painel administrativo.
SUPABASE_SECRET_KEY=sb_secret_...

# Mercado Pago — Suas integrações > Credenciais (etapa 6)
MERCADOPAGO_ACCESS_TOKEN=
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY=
MERCADOPAGO_WEBHOOK_SECRET=

# E-mail do primeiro administrador da plataforma (etapa 7)
PLATFORM_ADMIN_EMAIL=
