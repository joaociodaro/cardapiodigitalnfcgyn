# ------------------------------------------------------------------
# Copie para .env.local e preencha. Nunca faça commit do .env.local.
# ------------------------------------------------------------------

# URL pública do site (sem barra no final). Usada em SEO, QR Codes e e-mails.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase — Project Settings > API (usadas a partir da etapa 3)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Chave de serviço: SOMENTE no servidor (webhooks e admin). Ignora RLS.
SUPABASE_SERVICE_ROLE_KEY=

# Mercado Pago — Suas integrações > Credenciais (etapa 6)
# Use credenciais de TESTE até validar todo o fluxo.
MERCADOPAGO_ACCESS_TOKEN=
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY=
# Assinatura secreta do webhook (Webhooks > Configurar notificações)
MERCADOPAGO_WEBHOOK_SECRET=

# E-mail do primeiro administrador da plataforma (recebe o papel platform_admin)
PLATFORM_ADMIN_EMAIL=
